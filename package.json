{
  "name": "auralis-next",
  "version": "2.0.0",
  "description": "Next-Gen Supercharged YouTube Music Desktop Player with Liquid Glass & Ambient UI",
  "author": "PAPABVTIFY Team",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:electron": "tsc && vite build && electron-builder --win nsis portable",
    "build:mobile": "tsc && vite build && cap sync"
  },
  "build": {
    "appId": "com.papabvtify.music",
    "productName": "PAPABVTIFY",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "server.cjs",
      "src/services/playlistExtractor.cjs"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PAPABVTIFY-Setup.${ext}"
    },
    "portable": {
      "artifactName": "PAPABVTIFY.${ext}"
    }
  },
  "dependencies": {
    "@distube/ytdl-core": "^5.2.1",
    "clsx": "^2.1.1",
    "fast-average-color": "^9.4.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@types/node": "^22.8.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
